{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "COSMOS",
  "version": "0.0.0",
  "identifier": "app.cosmos.desktop",
  "build": {
    "beforeDevCommand": "pnpm --dir ../.. daemon:build && pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm --dir ../.. daemon:build && pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "COSMOS",
        "width": 1200,
        "height": 800,
        "minWidth": 640,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "icon": [],
    "externalBin": ["binaries/cosmosd"]
  }
}

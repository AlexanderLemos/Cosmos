{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "COSMOS",
  "version": "0.0.1",
  "identifier": "app.cosmos.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "COSMOS",
        "width": 1100,
        "height": 720,
        "minWidth": 800,
        "minHeight": 520,
        "backgroundColor": "#07060B"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "dmg", "app", "deb", "rpm", "appimage"],
    "category": "Productivity",
    "shortDescription": "Local-first knowledge and project memory",
    "license": "MIT",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VaultReply",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "paths"
        },
        "paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "paths"
      ]
    },
    {
      "type": "object",
      "properties": {
        "content": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "const": "note"
        },
        "path": {
          "type": "string"
        },
        "rev": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "path",
        "content",
        "rev"
      ]
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "saved"
        },
        "rev": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "rev"
      ]
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "project"
        },
        "path": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "path"
      ]
    }
  ]
}

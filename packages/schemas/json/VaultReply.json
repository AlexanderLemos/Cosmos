{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VaultReply",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "paths"
        },
        "paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "paths"
      ]
    },
    {
      "type": "object",
      "properties": {
        "available": {
          "type": "boolean"
        },
        "kind": {
          "type": "string",
          "const": "watch_state"
        },
        "revision": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "revision",
        "available"
      ]
    },
    {
      "type": "object",
      "properties": {
        "can_organize": {
          "type": "boolean"
        },
        "content": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "const": "note"
        },
        "path": {
          "type": "string"
        },
        "rev": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "path",
        "content",
        "rev",
        "can_organize"
      ]
    },
    {
      "type": "object",
      "properties": {
        "data_base64": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "const": "image"
        },
        "media_type": {
          "type": "string"
        },
        "path": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "path",
        "media_type",
        "data_base64"
      ]
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "saved"
        },
        "rev": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "rev"
      ]
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "project"
        },
        "path": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "path"
      ]
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "moved"
        },
        "path": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "path"
      ]
    },
    {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "const": "trashed"
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "id"
      ]
    },
    {
      "type": "object",
      "properties": {
        "entries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TrashEntry"
          }
        },
        "kind": {
          "type": "string",
          "const": "trash_entries"
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "entries"
      ]
    }
  ],
  "$defs": {
    "TrashEntry": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "rev": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "path",
        "rev"
      ]
    }
  }
}

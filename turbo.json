{
  "$schema": "https://turborepo.com/schema.json",
  "globalEnv": [
    "PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH",
    "COSMOS_ALL_BROWSERS",
    "COSMOS_E2E_PREVIEW"
  ],
  "globalDependencies": [
    "tsconfig.base.json",
    "tests/conformance/**",
    "crates/cosmos-storage/src/*.sql"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}

{
  "$schema": "https://turborepo.com/schema.json",
  "globalEnv": ["PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH"],
  "globalDependencies": ["tsconfig.base.json", "tests/conformance/**"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
